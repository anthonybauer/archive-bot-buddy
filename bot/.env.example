# ---- REQUIRED -------------------------------------------------------------
# Paste the token BotFather gave you (looks like 123456789:AAG...)
BOT_TOKEN=

# The ID of your private channel (looks like -1001234567890).
# Leave empty the first time: the dashboard will show it to you.
ALLOWED_CHANNEL_ID=

# Login for the web dashboard. Choose your own password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ---- OPTIONAL -------------------------------------------------------------
# Delete your original link post after the video was uploaded (true/false)
DELETE_ORIGINAL=true

# Reply "Already saved" instead of downloading the same link twice
SKIP_DUPLICATES=true

# Include the original link in the video caption
INCLUDE_SOURCE_URL=false

# How many videos to download at the same time (1-2 recommended)
MAX_CONCURRENT_DOWNLOADS=2

# Retries after a temporary network error
DOWNLOAD_RETRIES=2

# Give up on a single download after this many seconds
DOWNLOAD_TIMEOUT=600

# Telegram's bot upload limit is 50 MB. Raise this only if you run
# your own local Telegram Bot API server.
MAX_UPLOAD_MB=50

# Optional: path to a Netscape cookies.txt for private/logged-in content.
# Put the file in ./cookies/cookies.txt and set: /cookies/cookies.txt
COOKIES_FILE=

# Web dashboard port
PORT=8080

# Log detail: INFO or DEBUG
LOG_LEVEL=INFO
